# 请替换为随机字母数字密码；不要使用 URL 中需要转义的字符。
POSTGRES_PASSWORD=replace_with_random_alphanumeric_password
REVIEW_PORT=8766
# 本机 HTTP 使用 false；公网 HTTPS 部署必须设为 true。
COOKIE_SECURE=false
# 反向代理的可信来源，逗号分隔。限流按解析出的客户端 IP 计数，客户端地址从右往左取第一个
# 不在本列表中的转发地址，因此客户端伪造 X-Forwarded-For 无法绕过限流。
# 默认含 127.0.0.1,::1（宿主机反向代理）与 Docker 私网段；反向代理不在这些地址时改成它的实际地址。
# 不要设为 *：uvicorn 会改为取最左值，客户端可伪造。
FORWARDED_ALLOW_IPS=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
REVIEW_DOMAIN=review.example.com
