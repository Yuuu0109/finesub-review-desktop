+def _validate_preserved_value(store, overlay, node):
+    """An opt-in existing value update; never creates, retypes or relocates."""
+    stored = store.node(node.local_id, overlay.read_rev)
+    field_name = PRESERVED_VALUE_FIELDS.get(node.kind)
+    if stored is None or node.is_new or stored.kind != node.kind or field_name is None or node.retired:
+        raise ValueError("preserved value requires an existing supported node")
+    if node.visibility != stored.visibility:
+        raise ValueError("preserved value cannot change visibility")
+    old = {k: v for k, v in stored.payload.items() if k != field_name}
+    new = {k: v for k, v in node.payload.items() if k != field_name}
+    if old != new or not isinstance(node.payload.get(field_name), str) or not node.payload[field_name].strip():
+        raise ValueError("preserved value cannot change identity, labels or other payload fields")
+    identities = {"本名", "别名", "类型", "读音", "読み", "読み方"}
+    identity = str(stored.payload.get("label") or stored.payload.get("field") or "").strip(" -\t")
+    if node.kind == "note" and not identity:
+        identity = str(stored.payload.get("text") or "").lstrip(" -\t").split(":", 1)[0].split("：", 1)[0]
+    if identity in identities:
+        raise ValueError("preserved value cannot update a matching identity field")
+    from .importer import extract_misheard
+    if extract_misheard(str(stored.payload.get(field_name) or "")) != extract_misheard(node.payload[field_name]):
+        raise ValueError("preserved value cannot change derived misheard matching items")
+    if any(m.child_id == node.local_id for m in overlay.memberships.values()):
+        raise ValueError("preserved value cannot modify memberships")
+    if any(item.local_id == node.local_id for item in overlay.items.values()):
+        raise ValueError("preserved value cannot modify matching items")
+    # Only the existing imported kind is grandfathered. New kinds, structure,
+    # budgets, uniqueness, references, CAS and all other overlay checks remain.
+    validate_payload(node.kind, node.payload, strict=node.kind not in ("fact", "event", "relation"))
+
